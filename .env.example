# Copy to .env and fill what you have. Everything here is OPTIONAL -
# the dashboard runs on the free DEX Screener API with none of these set.

# --- LLM advice layer (rule-based advice works without it) ---
ANTHROPIC_API_KEY=

# --- X / Twitter (you said you have access) ---
# Option A: official X API v2  (recent search + counts)
TWITTER_BEARER_TOKEN=
# Option B: a third-party social data provider
SOCIAL_API_BASE=
SOCIAL_API_KEY=

# --- RugCheck: public endpoint, no key needed. Set to 1 to turn it off. ---
DISABLE_RUGCHECK=0
