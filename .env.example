# Copy to .env and fill what you have. Everything here is OPTIONAL -
# the dashboard runs on the free DEX Screener API with none of these set.

# --- LLM advice layer (rule-based advice works without it) ---
ANTHROPIC_API_KEY=


# --- RugCheck: public endpoint, no key needed. Set to 1 to turn it off. ---
DISABLE_RUGCHECK=0

# --- LunarCrush (social / attention pillar) ---
# https://lunarcrush.com/developers  - plans start around 10 req/min, which is
# why config.json only enriches the top `social.enrichTopN` tokens per scan.
LUNARCRUSH_API_KEY=

# --- Telegram ---
# mode=public needs NOTHING (public channels only, last ~20 posts).
# mode=bot: create a bot with @BotFather, add it to the channel as an admin.
TELEGRAM_BOT_TOKEN=
# mode=mtproto: sees every channel your account is in. api_id/api_hash from
# https://my.telegram.org. Generate TELEGRAM_SESSION yourself - see the snippet
# in src/telegram/index.mjs. It is a full account credential; keep it here only.
TG_API_ID=
TG_API_HASH=
TELEGRAM_SESSION=
